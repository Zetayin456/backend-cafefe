<server description="cafefe server">
    <featureManager>
        <feature>webProfile-10.0</feature>
        <feature>faces-4.0</feature>
        <feature>persistence-3.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="9443" />

    <library id="PostgreSQLDriver">
        <fileset dir="${shared.resource.dir}" includes="postgresql.jar" />
    </library>

    <library id="PrimeFacesLib">
        <fileset dir="${shared.resource.dir}" includes="primefaces-14.0.0-jakarta.jar" />
    </library>

    <dataSource id="pgdb" jndiName="jdbc/pgdb">
        <jdbcDriver libraryRef="PostgreSQLDriver" />
        <properties.postgresql
            serverName="${env.PG_HOST}"
            portNumber="${env.PG_PORT}"
            databaseName="${env.PG_DB}"
            user="${env.PG_USER}"
            password="${env.PG_PASS}" />
    </dataSource>

    <webApplication id="cafefe" location="cafefe.war" contextRoot="/cafefe">
        <classloader commonLibraryRef="PrimeFacesLib" />
    </webApplication>
</server>